# Labor Intelligence Virtual Lab — environment variables
# Copy to .env and fill in values

# Claude AI (for Playground tab)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: BLS API key (increases rate limits; free from https://data.bls.gov/registrationEngine/)
BLS_API_KEY=

# Optional: O*NET Web Services credentials (free from https://services.onetcenter.org/)
ONET_USERNAME=
ONET_PASSWORD=

# Lab server
LAB_HOST=0.0.0.0
LAB_PORT=8766

# Lab Rats — autonomous research agents (OpenRouter)
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Model overrides per rat (defaults shown — any OpenRouter model ID works)
RAT_MODEL_RESEARCHER=anthropic/claude-opus-4
RAT_MODEL_ANALYST=anthropic/claude-opus-4
RAT_MODEL_VISUALIZER=anthropic/claude-opus-4
RAT_MODEL_MONITOR=google/gemini-flash-1.5
